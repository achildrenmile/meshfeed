# Werte ohne Anfuehrungszeichen schreiben. Compose nimmt den Rest der Zeile
# woertlich. Zwei Zeichen sind giftig: # leitet einen Kommentar ein, $ loest
# Interpolation aus. Kanalnamen mit # deshalb in Anfuehrungszeichen — siehe
# CHANNELS unten, das ist die eine Ausnahme.

# Name der Instanz. Steckt in Containernamen, Volume und MQTT-Client-ID.
INSTANCE_NAME=kf-feed

# --- Woher die Pakete kommen --------------------------------------------
# http = von der Karte (mehrere Observer, bis zu ein Abrufintervall
#        Verzoegerung, fremder Dienst dazwischen)  ← Vorgabe
# mqtt = vom eigenen Broker (ein Observer, dafuer sofort)
#
# Es gibt keinen Rueckfall: was hier steht, laeuft. Wer den eigenen Broker
# will, muss es hinschreiben — sonst wechselt der Dienst beim naechsten
# Neuaufbau still die Quelle, weil die Vorgabe im Code http ist.
QUELLE=mqtt

# --- Quelle http: Karten-API --------------------------------------------
# KARTE_URL=https://map.carinthiamesh.com
# KARTE_INTERVALL_S=20
# KARTE_LIMIT=200
# Das Fenster beginnt so viele Sekunden vor dem juengsten gesehenen Paket.
# Faengt verspaetet einsortierte Pakete; Doppelte faengt der Dedup.
# KARTE_UEBERLAPPUNG_S=60
# Deckel gegen die Flut nach einer laengeren Stoerung.
# KARTE_MAX_SEITEN=5

# --- Quelle mqtt: Broker des Observer-Stacks ----------------------------
# Nur lesend. Der Feed haengt nie direkt am Companion-Node — der vertraegt
# zwei TCP-Clients, und die sind belegt (Observer-Bridge + meshinfra).
MQTT_HOST=<IP-des-Observer-Hosts>
MQTT_PORT=1884
MQTT_USER=meshfeed
MQTT_PASS=hier-eintragen
MQTT_TOPICS=meshcore/+/+/packets

# --- Kanaele ------------------------------------------------------------
# Komma-Liste aus name=Beschriftung. Der Schluessel wird aus dem Namen
# abgeleitet (SHA256("#name")[:16]). "public" meint den festen Public-Key.
CHANNELS="#kf=Kärnten funkt"

# Private Kanaele, deren Schluessel sich nicht aus dem Namen ergibt:
# CHANNEL_KEYS=intern=00112233445566778899aabbccddeeff=Intern
CHANNEL_KEYS=

# --- Anzeige ------------------------------------------------------------
# Theme = Dateiname ohne .css in app/static/themes/. Mitgeliefert: plain, kf.
# Eigenes Theme: Datei dort ablegen (nur Variablen setzen) und hier eintragen.
THEME=kf
SITE_LOGO_URL=/static/logo.png
# Ohne eigenen Wert dient das Logo als Favicon.
SITE_FAVICON_URL=/static/favicon.png
SITE_TITLE=Kärnten funkt im Mesh
# Anfuehrungszeichen, weil ein # sonst den Rest der Zeile abschneidet.
SITE_TAGLINE="Mitgehört auf #kf im CarinthiaMesh"
SITE_LINK_URL=https://kaernten-funkt.at
SITE_LINK_LABEL=kaernten-funkt.at

# Zusatz in der Fusszeile, etwa der Standort des Observers. Die Namen der
# Observer selbst stehen ohnehin dort — die kommen aus den Daten.
# SITE_NOTE=Observer-Standort Nötsch im Gailtal
# Zweiter Weg zum Mitlesen, erscheint als Link in der Fusszeile.
# Anfuehrungszeichen noetig: die URL enthaelt ein #, sonst waere der Rest
# der Zeile ein Kommentar.
SITE_ALSO_URL="https://map.carinthiamesh.com/#/channels/kf"
SITE_ALSO_LABEL=Kanalansicht auf map.carinthiamesh.com

SITE_NOTE=

# --- Betrieb ------------------------------------------------------------
# 0 = nie loeschen
RETENTION_DAYS=30
HOST_PORT=3430

# Minuten ohne ein einziges Paket, ab denen /healthz/quelle auf 503 geht.
# Gemeint ist die Leitung, nicht der Kanal: Ein ruhiger #kf ist normal, der
# Observer dagegen hoert dauernd etwas. Bleibt es hier still, ist die Quelle
# tot. Der Docker-Healthcheck haengt an /healthz und bleibt davon unberuehrt.
QUELLE_STILL_MINUTEN=30

# --- Discord-Spiegel ----------------------------------------------------
# Leer = aus. Diese Instanz braucht das nicht — den Spiegel betreibt eine
# eigene Instanz (siehe ~/meshdiscord), damit der oeffentliche Feed nicht
# nebenbei Kanaele anzeigt, die nur nach Discord sollen.
#
# Ein Webhook kann ausschliesslich in genau einen Kanal schreiben. Er kann
# nicht lesen: dass aus Discord nichts ins Funknetz zurueckkommt, haengt
# damit nicht an Disziplin, sondern daran, was das Token kann.
#
# Schluessel ist der Slug des Kanals (#at-ktn-bot -> at-ktn-bot), Sonderziel
# _knoten nimmt die Knotenmeldungen auf. Anfuehrungszeichen noetig, sobald
# ein # im Namen steht.
# DISCORD_WEBHOOKS="at-ktn=https://discord.com/api/webhooks/…,_knoten=https://…"

# Abstand zwischen zwei Posts je Webhook. Discord erlaubt 5 Anfragen/2 s und
# rund 30/60 s — 2,5 s bleibt mit Abstand darunter, statt die Grenze zu
# suchen. Nicht ohne Grund kleiner stellen.
# DISCORD_MIN_ABSTAND_S=2.5

# Laeuft die Warteschlange voll, wird verworfen statt gepuffert: eine
# Funkzeile von vor einer Stunde will niemand mehr lesen.
# DISCORD_WARTESCHLANGE_MAX=200

# Loggt statt zu senden. Fuer den ersten Lauf.
# DISCORD_TROCKENLAUF=true

# Sekunden Stille nach dem Start, bevor gepostet wird. Absicherung gegen
# retained Messages: nach einem Neustart soll nichts Altes nachkommen.
# DISCORD_START_STILL_S=5

# Hops und SNR als Kleinschrift unter die Nachricht.
# DISCORD_FUNKDATEN=true

# Knotenmeldungen (neuer Knoten, Umbenennung) an das Ziel _knoten. Der rohe
# Advert-Strom waere mit rund 650 Meldungen am Tag unlesbar; gepostet werden
# nur die Uebergaenge.
# DISCORD_KNOTEN=true
# Beim ersten Start ist jeder Knoten neu — so viele Minuten lang wird nur
# gefuellt, nicht gemeldet.
# DISCORD_WARMUP_MIN=30

# Welche Knoten in den _knoten-Kanal gemeldet werden. Der eigene Observer
# hoert die Nachbarschaft, die Karte dagegen ganz Oesterreich — ohne Filter
# stuenden dort Neuzugaenge aus Graz und dem Burgenland. Leer = alles melden.
# DISCORD_KNOTEN_MUSTER=^AT-(K|KL|VI|VL|FE|HE|SV|SP|VK|WO)-
