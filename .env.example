# Werte ohne Anfuehrungszeichen schreiben. Compose nimmt den Rest der Zeile
# woertlich. Zwei Zeichen sind giftig: # leitet einen Kommentar ein, $ loest
# Interpolation aus. Kanalnamen mit # deshalb in Anfuehrungszeichen — siehe
# CHANNELS unten, das ist die eine Ausnahme.

# Name der Instanz. Steckt in Containernamen, Volume und MQTT-Client-ID.
INSTANCE_NAME=kf-feed

# --- Quelle: Broker des Observer-Stacks ---------------------------------
# Nur lesend. Der Feed haengt nie direkt am Companion-Node — der vertraegt
# zwei TCP-Clients, und die sind belegt (Observer-Bridge + meshinfra).
MQTT_HOST=<IP-des-Observer-Hosts>
MQTT_PORT=1884
MQTT_USER=meshfeed
MQTT_PASS=hier-eintragen
MQTT_TOPICS=meshcore/+/+/packets

# --- Kanaele ------------------------------------------------------------
# Komma-Liste aus name=Beschriftung. Der Schluessel wird aus dem Namen
# abgeleitet (SHA256("#name")[:16]). "public" meint den festen Public-Key.
CHANNELS="#kf=Kärnten funkt"

# Private Kanaele, deren Schluessel sich nicht aus dem Namen ergibt:
# CHANNEL_KEYS=intern=00112233445566778899aabbccddeeff=Intern
CHANNEL_KEYS=

# --- Anzeige ------------------------------------------------------------
# Theme = Dateiname ohne .css in app/static/themes/. Mitgeliefert: plain, kf.
# Eigenes Theme: Datei dort ablegen (nur Variablen setzen) und hier eintragen.
THEME=kf
SITE_LOGO_URL=/static/logo.png
# Ohne eigenen Wert dient das Logo als Favicon.
SITE_FAVICON_URL=/static/favicon.png
SITE_TITLE=Kärnten funkt im Mesh
# Anfuehrungszeichen, weil ein # sonst den Rest der Zeile abschneidet.
SITE_TAGLINE="Mitgehört auf #kf im CarinthiaMesh"
SITE_LINK_URL=https://kaernten-funkt.at
SITE_LINK_LABEL=kaernten-funkt.at

# Zusatz in der Fusszeile, etwa der Standort des Observers. Die Namen der
# Observer selbst stehen ohnehin dort — die kommen aus den Daten.
# SITE_NOTE=Observer-Standort Nötsch im Gailtal
# Zweiter Weg zum Mitlesen, erscheint als Link in der Fusszeile.
# Anfuehrungszeichen noetig: die URL enthaelt ein #, sonst waere der Rest
# der Zeile ein Kommentar.
SITE_ALSO_URL="https://map.carinthiamesh.com/#/channels/kf"
SITE_ALSO_LABEL=Kanalansicht auf map.carinthiamesh.com

SITE_NOTE=

# --- Betrieb ------------------------------------------------------------
# 0 = nie loeschen
RETENTION_DAYS=30
HOST_PORT=3430
